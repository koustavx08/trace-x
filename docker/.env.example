# TRACE-X production Docker Compose environment
#
# Copy to docker/.env and fill in real values:
#   cp docker/.env.example docker/.env
#
# docker-compose.prod.yml substitutes every ${VAR} below from this file
# (Compose reads .env from the directory of the first -f file, which is
# this docker/ directory for both compose files in this repo). NEVER
# commit the real docker/.env -- .gitignore already excludes it.
#
# Validate before first deploy:
#   cd apps/api && python scripts/validate_env.py
# (point it at this file's values by exporting them, or by copying this
# file to apps/api/.env for the check -- see docs/SECRETS_MANAGEMENT.md)

# --- Required for core (see docs/EXTERNAL_SERVICES_SETUP.md) --------------
SECRET_KEY=
POSTGRES_USER=tracex
POSTGRES_PASSWORD=
POSTGRES_DB=tracex
NEO4J_USER=neo4j
NEO4J_PASSWORD=
CORS_ORIGINS=["https://your-domain.example"]
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Optional: logging ------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Optional: database connection pool tuning -------------------------------
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Optional: AI assistant --------------------------------------------------
# --- Optional: OpenRouter AI provider ----------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
# AI_PROVIDER: anthropic | openrouter (defaults to anthropic when unset)
AI_PROVIDER=
# Unset -> AI_MODE auto-selects "demo" (no key) or "live" (key present).
# Set explicitly to force a mode regardless of key presence.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_MODE=

# --- Optional: blockchain data providers -------------------------------------
ALCHEMY_API_KEY=
INFURA_API_KEY=
INFURA_API_SECRET=
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BASE_RPC_URL=
# Neither Alchemy nor Infura vendor BSC; point this at any JSON-RPC endpoint
# (a public node, or Ankr/QuickNode/Chainstack).
BSC_RPC_URL=

# --- Optional: entity intelligence --------------------------------------------
CHAINALYSIS_API_KEY=
CIPHERTRACE_API_KEY=
