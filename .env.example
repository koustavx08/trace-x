# TRACE-X Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Application
APP_ENV=development
SECRET_KEY=your-secret-key-min-32-chars
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://tracex:tracex@localhost:5432/tracex

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tracexneo4j

# Redis (for caching/queue)
REDIS_URL=redis://localhost:6379/0

# Blockchain Providers - Ethereum
ALCHEMY_API_KEY=your-alchemy-key
INFURA_API_KEY=your-infura-key
INFURA_API_SECRET=your-infura-secret
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# Blockchain Providers - Polygon, Arbitrum, Optimism, Base (all Alchemy/Infura-supported)
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BASE_RPC_URL=

# Blockchain Providers - BSC (no Alchemy/Infura vendor support; point at any
# JSON-RPC endpoint -- a public node, or Ankr/QuickNode/Chainstack)
BSC_RPC_URL=

# Entity Intelligence Sources
CHAINALYSIS_API_KEY=
CIPHERTRACE_API_KEY=
OFAC_SDN_LIST_URL=https://www.treasury.gov/ofac/downloads/sdn.csv

# AI Assistant (see docs/EXTERNAL_SERVICES_SETUP.md)
# Unset ANTHROPIC_API_KEY -> deterministic demo-mode responses, never a 500.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# AI_MODE: live | demo | disabled. Leave unset to auto-select based on
AI_PROVIDER= # anthropic | openrouter (defaults to anthropic when unset)
OPENROUTER_API_KEY= # Your OpenRouter API key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL= # e.g., anthropic/claude-3.5-sonnet
# whether ANTHROPIC_API_KEY is present.
AI_MODE=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json