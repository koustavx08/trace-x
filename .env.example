# TRACE-X Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Application
APP_ENV=development
SECRET_KEY=your-secret-key-min-32-chars
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://tracex:tracex@localhost:5432/tracex

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tracexneo4j

# Redis (for caching/queue)
REDIS_URL=redis://localhost:6379/0

# Blockchain Providers - Ethereum
ALCHEMY_API_KEY=your-alchemy-key
INFURA_API_KEY=your-infura-key
INFURA_API_SECRET=your-infura-secret
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# Blockchain Providers - Polygon
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# Entity Intelligence Sources
CHAINALYSIS_API_KEY=
CIPHERTRACE_API_KEY=
OFAC_SDN_LIST_URL=https://www.treasury.gov/ofac/downloads/sdn.csv

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json